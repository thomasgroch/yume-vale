FROM node:22-alpine AS build
WORKDIR /app
COPY apps/admin/package*.json ./
RUN npm ci
COPY apps/admin/ .
RUN npm run build

# Standalone Next.js output — no node_modules needed at runtime.
FROM node:22-alpine
RUN addgroup --system yume && adduser --system --ingroup yume yume
WORKDIR /app
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
# Next.js standalone doesn't copy public/ automatically
# COPY --from=build /app/public ./public
USER yume
EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV NODE_ENV=production
CMD ["node", "server.js"]
