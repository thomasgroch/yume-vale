FROM rust:1.96-bookworm AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build
RUN rustup target add wasm32-unknown-unknown \
 && curl -fsSL "https://github.com/trunk-rs/trunk/releases/latest/download/trunk-$(uname -m)-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin \
 && curl -fsSL "https://github.com/WebAssembly/binaryen/releases/download/version_131/binaryen-version_131-x86_64-linux.tar.gz" \
    | tar -xz -C /opt
# trunk runs wasm-opt without feature flags, and this wasm uses bulk-memory
# (Rust >= 1.87 default), which trunk's bundled v123 rejects. A PATH shim
# (found via trunk's find_system before its cache) runs binaryen v131 with
# the required features enabled instead. The trailing -Oz overrides trunk's -O.
RUN printf '#!/bin/sh\nexec /opt/binaryen-version_131/bin/wasm-opt --enable-bulk-memory-opt --enable-nontrapping-float-to-int --enable-sign-ext "$@" -Oz\n' \
    > /usr/local/bin/wasm-opt && chmod +x /usr/local/bin/wasm-opt
COPY --from=planner /app/recipe.json recipe.json
# Builds only third-party deps from the recipe — this layer is cached across
# pushes as long as Cargo.lock doesn't change, instead of recompiling the
# whole dependency tree on every commit.
RUN CARGO_BUILD_JOBS=2 cargo chef cook --release --target wasm32-unknown-unknown -p client --recipe-path recipe.json
COPY . .
# certs/ is gitignored (dev-only); the local WT digest include_str! needs a
# placeholder, while production uses CA validation and falls back to WSS.
RUN mkdir -p certs && echo 00 > certs/digest.txt
# Baked into the wasm at compile time (option_env!); empty = derive from page host.
ARG YUME_SERVER_WS_URL=""
ENV YUME_SERVER_WS_URL=$YUME_SERVER_WS_URL
WORKDIR /app/apps/client
# Release profile: CI runners have 16GB (LTO + wasm-opt OOMed the old 8GB VPS).
# Jobs=2 keeps peak RAM comfortable.
RUN CARGO_BUILD_JOBS=2 trunk build --release

FROM nginx:1-alpine
COPY apps/client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client/dist /usr/share/nginx/html
EXPOSE 80
