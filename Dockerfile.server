# Dev profile on purpose: workspace dev sets deps opt-level=3, so the server
# runs fast enough while building in a fraction of the time/RAM of release.
FROM rust:1-bookworm AS build
WORKDIR /app
COPY . .
RUN cargo build -p server

FROM debian:bookworm-slim
RUN useradd --system yume
COPY --from=build /app/target/debug/server /usr/local/bin/yume-server
USER yume
EXPOSE 5000/udp 5001/udp 5002/tcp
CMD ["yume-server"]
